generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id           Int                @id @default(autoincrement())
  discordId    String             @unique
  robloxId     BigInt             @unique
  nameIC       String             @unique
  rank         String
  shiftsHosted Shift[]            @relation("EmployeeShiftsHosted")
  shiftLogs    ShiftEmployeeLog[] @relation
  shiftReports ShiftReport[]      @relation
  loas         LOA[]

  employeeChanges       EmployeeChange[] @relation("EmpChanges")
  employeeChangesIssued EmployeeChange[] @relation("EmpChangesIssued")
  qualification         EmployeeQual?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ShiftEmployeeLog {
  id Int @id @default(autoincrement())

  shift    Shift    @relation(fields: [shiftId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  absence     Boolean?
  clockedIn   DateTime?
  clockedTime Int?

  exposureTime Int?
  dose         Int?

  stations     String[]
  stationTimes DateTime[]
  rating       String[]

  accidents Accident[] @relation

  shiftId    Int
  employeeId Int

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([shiftId, employeeId])
}

model Shift {
  id Int @id @default(autoincrement())

  shiftNumber             String             @unique
  plannedDate             DateTime
  plannedDuration         Int                @default(60)
  plannedBriefingDuration Int                @default(15)
  employeeLogs            ShiftEmployeeLog[] @relation
  host                    Employee           @relation(name: "EmployeeShiftsHosted", fields: [hostId], references: [id])
  unit                    String
  shortDesc               String
  shiftGoal               String
  notes                   String

  report ShiftReport? @relation

  hostId Int

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ShiftReport {
  shiftId Int   @id
  shift   Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  date             DateTime
  duration         Int?
  briefingDuration Int?
  cohost           Employee? @relation(fields: [cohostId], references: [id])
  cohostLocation   String?

  goalMet    Boolean?
  rodBalance RodBalance?
  summary    String?

  accidents Accident[] @relation
  cohostId  Int?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum RodBalance {
  Auto
  Manual
  None
}

model Accident {
  id          Int         @id @default(autoincrement())
  shiftReport ShiftReport @relation(fields: [shiftReportId], references: [shiftId])

  date                 DateTime
  involvedEmployeeLogs ShiftEmployeeLog[] @relation
  description          String

  shiftReportId Int

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model LOA {
  id       Int      @id @default(autoincrement())
  employee Employee @relation(fields: [employeeId], references: [id])

  dateStart DateTime @default(now())
  duration  Int
  reason    String

  employeeId Int

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum EmpChangeType {
  promotion
  warn // uwaga pisemna
  reprimand
  suspension
}

model EmployeeChange {
  id       Int           @id @default(autoincrement())
  employee Employee      @relation("EmpChanges", fields: [employeeId], references: [id])
  issuer   Employee      @relation("EmpChangesIssued", fields: [issuerId], references: [id])
  type     EmpChangeType
  reason   String
  note     String
  newRole  String

  employeeId Int
  issuerId   Int

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model EmployeeQual {
  employeeId Int      @id @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  pracownik       Boolean @default(false)
  jadrowy         Boolean @default(false)
  kierownikZmiany Boolean @default(false)
  szkoleniowiec   Boolean @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
